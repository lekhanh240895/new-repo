{
  "name": "biomonitor-dms",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-native driver monitoring: on-device drowsiness and distraction alerts. No video leaves the device.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "assets": "node scripts/fetch-assets.mjs",
    "predev": "npm run -s assets",
    "predev:phone": "npm run -s assets",
    "prebuild": "npm run -s assets",
    "prepreview": "npm run -s assets",
    "dev": "vite",
    "dev:phone": "vite --host --mode phone",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "replay": "node scripts/replay.mjs",
    "smoke": "node scripts/make-test-clip.mjs replay-out/smoke-dark.y4m && node scripts/replay.mjs --clip replay-out/smoke-dark.y4m --seconds 4 --params delegate=cpu --expect-sensor LOW_VISIBILITY",
    "check": "npm run typecheck && npm run lint && npm run test",
    "offline-check": "node scripts/offline-check.mjs",
    "scenarios": "node scripts/scenarios.ts",
    "tune": "node scripts/tune.ts",
    "clips": "node scripts/clips.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "@picocss/pico": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "playwright": "1.63.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
